// The report service for this fork's test builds (README.md). Deploy: npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "solidcraft-reports",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // The repository issues are filed on (owner/name).
    "GITHUB_REPO": "kaztre/solidcraft",
    // Labels for every report, comma-separated. Create them on GitHub first, or they are skipped.
    "LABELS": "bug,from-app"
  },
  // GITHUB_TOKEN and REPORT_KEY are secrets: npx wrangler secret put GITHUB_TOKEN (never here).
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "4711",
      // Per sender's IP address: at most 3 reports a minute.
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Screenshots. Remove this block to run without R2: reports then arrive without them.
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "solidcraft-report-shots" }]
}
